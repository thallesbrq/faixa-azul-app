{
  "name": "faixa-azul",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Preparacao para a prova de faixa azul - Academia Rilion Gracie Garopaba",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @faixa-azul/aluno",
    "build": "npm run build --workspace @faixa-azul/aluno",
    "preview": "npm run preview --workspace @faixa-azul/aluno",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:regras": "firebase emulators:exec --only firestore --project faixa-azul-testes 'vitest run --config vitest.regras.config.ts'",
    "emuladores": "firebase emulators:start --project faixa-azul-testes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.29.0",
    "oxlint": "1.0.0",
    "typescript": "~5.9.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}
