rules_version = '2';

// ---------------------------------------------------------------------------
// Regras de acesso ao Firestore.
//
// ESTE ARQUIVO E A UNICA FRONTEIRA DE SEGURANCA DO PRODUTO.
//
// O bundle JavaScript vai para o navegador de qualquer pessoa, e a chave de API
// do Firebase vai dentro dele — repositorio privado nao muda isso. Portanto
// nada no cliente protege nada. Se uma regra aqui estiver errada, um aluno le o
// progresso de outro, e NADA QUEBRA: nao ha erro, nao ha tela vermelha, so
// alguem vendo o que nao devia. Por isso cada regra tem teste em
// firestore.rules.test.ts, e o CI barra o deploy se um deles falhar.
//
// PRINCIPIO: a posse e desenhada para que o conflito nao exista.
//   - o ALUNO escreve so o proprio estado
//   - o PROFESSOR escreve so grade, validacao, competencia, graduacao e indicacao
//   - nenhum dos dois consegue escrever no campo do outro
// Assim a disputa aluno-professor deixa de ser problema de merge e passa a ser
// impossivel por construcao.
//
// TRES PAPEIS DESDE O ADR-017, e a linha entre os dois de cima e "o que nao se
// desfaz": o ADMIN administra o que se desfaz (cadastro, convite, turma, grade),
// o PROFESSOR assina o que nao se desfaz (validacao, competencia, graduacao —
// as tres colecoes append-only). O admin e o desenvolvedor, e ele tem cadastro
// de aluno nesta mesma academia: sem essa separacao ele assinaria a propria
// graduacao, e o log append-only viraria decoracao.
//
// `get` E `list` SAO REGRAS DIFERENTES, e confundi-los custou um bug que ficou
// no ar: numa consulta de colecao o curinga do caminho nao esta ligado a
// documento nenhum, entao toda regra que chama `get(.../$(uid))` ERRA em `list`
// — e erro em regra e negacao. `listarPessoas()`, a primeira leitura da Central,
// era recusada para o professor. Ver o comentario em `pessoas`.
//
// SOBRE O LOG DO EMULADOR: ele reporta `evaluation error` em algumas negacoes,
// alem de `false`. Duas causas reais foram encontradas e corrigidas (ordem da
// guarda de autenticacao, e `.data` sem guarda de nulo). Restaram entradas que
// eu NAO consegui atribuir — nenhuma delas muda resultado: as 93 assercoes
// cobrem cada caminho de permitir e negar, e todas passam. Fica registrado como
// observacao aberta, e nao como coisa entendida.
//
// UMA HIPOTESE TESTADA E REFUTADA, para ninguem gastar a mesma hora de novo:
// achei que o erro na regra de `update` de `pessoas` viesse de `resource` ser
// nulo no caminho de create (um `set` faz o Firestore avaliar create E update).
// Acrescentei `resource != null` e rodei: o `evaluation error` continuou
// identico, na mesma linha e coluna. Nao e isso. O log tambem reporta erro E
// `false` para a MESMA linha na mesma requisicao, o que sugere mais de uma
// passagem de avaliacao — mas isso e suposicao, e fica como suposicao.
//
// CUSTO DE LEITURA: checar "quem sou eu" exige um get() em `pessoas`, e cada
// get() dentro de uma regra e uma leitura cobrada. Com 20 alunos e uma academia
// isso e irrisorio. A alternativa mais barata seria por o papel numa custom
// claim do token (zero leitura), mas isso exige Cloud Functions, que exige o
// plano Blaze. Fica registrado como a otimizacao a fazer se o custo aparecer.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------- ajudas

    function autenticado() {
      return request.auth != null;
    }

    function souEu(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    /**
     * DUAS CAMADAS DE PROPOSITO: a de fora guarda, a de dentro consulta.
     *
     * `let` em regra do Firestore e avaliado ANTES do `return` — nao ha
     * curto-circuito dentro da mesma funcao. Na primeira versao destas ajudas os
     * `let` ficavam junto do `return autenticado() && ...`, e com requisicao
     * anonima o caminho `pessoas/$(request.auth.uid)` era montado com uid nulo:
     * a regra ERRAVA em vez de NEGAR. O emulador negava do mesmo jeito (erro em
     * regra e negacao) e os 23 testes passavam — negando pelo motivo errado.
     *
     * Negacao por erro e fragil: ela nao expressa a decisao, so acontece. Uma
     * edicao futura que mude a ordem das clausulas pode transformar erro em
     * permissao sem nenhum teste reclamar.
     *
     * Com a guarda numa funcao de FORA, o `&&` curto-circuita antes de chamar a
     * de dentro, e nenhum `get()` e montado sem auth.
     *
     * Custo: o Firestore permite dez acessos a documento por avaliacao e cobra
     * cada um. As funcoes internas gastam no maximo dois.
     */
    function souAtivo() {
      return autenticado() && euAtivo();
    }

    function euAtivo() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null && eu.data.ativo == true;
    }

    /**
     * DOIS NIVEIS DE PODER, E A LINHA ENTRE ELES E "O QUE NAO SE DESFAZ".
     *
     *   o admin administra o que se desfaz; o professor assina o que nao se desfaz.
     *
     * `souProfessor()` e a autoridade de TATAME: `validacoes`, `competencias` e
     * `graduacoes` — exatamente as tres colecoes com `update, delete: if false`
     * mais abaixo. `souGestor()` e a autoridade ADMINISTRATIVA: cadastro,
     * convite, turma, meta, grade.
     *
     * O MOTIVO E CONCRETO E E SOBRE O DESENVOLVEDOR (ADR-017, decisao 1). Ele e
     * faixa branca 3 graus e escreve este app. Como `professor`, poderia atestar
     * as competencias do proprio cadastro de aluno e conceder a si mesmo o 1o
     * grau. O log append-only do ADR-010 existe para que evidencia de graduacao
     * nao seja reescrevivel — e alguem que assina a propria graduacao faz o log
     * virar decoracao. `admin` e o papel que ve tudo e NAO PODE SE GRADUAR.
     *
     * O QUE FECHA A PORTA DE VOLTA e a regra de `papel` em `pessoas`: sem ela o
     * admin se promoveria a professor e assinaria, e esta divisao seria teatro.
     */
    function souProfessor() {
      return autenticado() && euProfessor();
    }

    function euProfessor() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null && eu.data.papel == 'professor' && eu.data.ativo == true;
    }

    /** Professor OU admin: quem administra a academia. */
    function souGestor() {
      return autenticado() && euGestor();
    }

    function euGestor() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null
        && (eu.data.papel == 'professor' || eu.data.papel == 'admin')
        && eu.data.ativo == true;
    }

    // O professor so alcanca quem esta na MESMA academia. Hoje existe uma so,
    // entao a comparacao e sempre verdadeira — e esta escrita de proposito:
    // quando aparecer a segunda academia, o isolamento ja esta aqui, e nao
    // dependera de alguem lembrar de acrescentar.
    function mesmaAcademiaQue(uid) {
      return autenticado() && euGestorDaAcademiaDe(uid);
    }

    function euGestorDaAcademiaDe(uid) {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      let ele = get(/databases/$(database)/documents/pessoas/$(uid));
      return eu != null && ele != null
        && (eu.data.papel == 'professor' || eu.data.papel == 'admin')
        && eu.data.ativo == true
        && eu.data.academiaId == ele.data.academiaId;
    }

    /**
     * O PROFESSOR — e so ele — da academia desta pessoa.
     *
     * Existe separada de `mesmaAcademiaQue` porque as tres colecoes append-only
     * exigem autoridade de tatame, e nao de administracao. Se as duas fossem a
     * mesma funcao, acrescentar `admin` a ela teria aberto `competencias` e
     * `graduacoes` de uma vez, sem nenhuma linha falando de graduacao.
     */
    function professorDaAcademiaDe(uid) {
      return autenticado() && euProfessorDaAcademiaDe(uid);
    }

    function euProfessorDaAcademiaDe(uid) {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      let ele = get(/databases/$(database)/documents/pessoas/$(uid));
      return eu != null && ele != null
        && eu.data.papel == 'professor'
        && eu.data.ativo == true
        && eu.data.academiaId == ele.data.academiaId;
    }

    // Sem guarda de nulo, `.data` sobre um get() que nao achou nada faz a regra
    // ERRAR. Erro em regra e negacao, entao o efeito visivel e o mesmo — mas a
    // decisao deixa de estar escrita e passa a ser acidente.
    function minhaAcademia() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null ? eu.data.academiaId : '';
    }

    // ------------------------------------------------------------- convites
    /**
     * Convite indexado por E-MAIL, e nao por uid.
     *
     * O FURO QUE ISTO FECHA: `pessoas/{uid}` so podia ser criado por um
     * professor, mas o uid nasce no PRIMEIRO LOGIN. Ou seja, o professor nao
     * tinha o que digitar — o convite era impossivel de existir. O e-mail, ao
     * contrario, ele sabe antes.
     *
     * Com isso a pessoa passa a poder criar o PROPRIO cadastro, mas SO quando
     * ha convite para o e-mail dela. Continua nao existindo cadastro aberto: sem
     * convite, ninguem entra.
     *
     * O id do documento e o e-mail em minusculas. E-mail e id valido no
     * Firestore (nao contem `/`), e normalizar evita que
     * `Thalles@x.com` e `thalles@x.com` sejam dois convites.
     */
    match /convites/{email} {
      // O convidado le o proprio convite (para saber que existe); o professor
      // le todos os da academia dele.
      allow read: if souGestor()
        || (autenticado() && request.auth.token.email == email);

      /**
       * QUEM CONVIDA COM QUE PAPEL (ADR-017, decisao 2).
       *
       * O admin convida ALUNO. Convite de `professor` ou de `admin` so o
       * professor cria — e essa e a mesma trava de `papel` em `pessoas` vista
       * pela porta de entrada: sem ela, o admin se convidaria de novo como
       * professor com um segundo e-mail, entraria, e assinaria a propria
       * graduacao. A porta dos fundos anula a da frente.
       */
      allow create, update: if request.resource.data.academiaId == minhaAcademia()
        && (
          (souGestor() && request.resource.data.papel == 'aluno')
          || (souProfessor() && request.resource.data.papel in ['aluno', 'professor', 'admin'])
        );

      // CONVITE E DE USO UNICO: quem consome apaga o proprio. Sem isto, um
      // convite antigo ficaria valido para sempre — e se o professor
      // desativasse alguem apagando o cadastro, a pessoa se recadastraria com o
      // convite velho. O professor tambem pode apagar (cancelar convite).
      allow delete: if souGestor()
        || (autenticado() && request.auth.token.email == email);
    }

    // ------------------------------------------------------------- pessoas

    match /pessoas/{uid} {
      /**
       * `get` E `list` SEPARADOS, E ISSO CONSERTA UM BUG QUE ESTAVA NO AR.
       *
       * Era uma linha so: `allow read: if souEu(uid) || mesmaAcademiaQue(uid)`.
       * Funciona para `get`, e NAO FUNCIONA PARA `list`: numa consulta de
       * colecao o curinga `{uid}` nao esta ligado a documento nenhum, entao
       * `souEu(null)` da falso e `mesmaAcademiaQue(null)` monta
       * `get(pessoas/null)` — a regra ERRA, e erro em regra e negacao.
       *
       * O EFEITO: `listarPessoas()` — a PRIMEIRA coisa que a Central faz, e o
       * que a aba do professor no celular tambem faz — era recusada. Para o
       * professor tambem, e nao so para o papel novo.
       *
       * Descoberto ao escrever `admin: ve tudo`, e confirmado como pre-existente
       * rodando a mesma sonda contra a versao anterior deste arquivo: mesma
       * negacao, mesmo erro, outra linha. Nenhuma das 67 assercoes anteriores
       * LISTAVA `pessoas` — todas pediam documento por documento. A colecao mais
       * importante da Central estava sem o teste do seu caminho mais usado.
       *
       * `souGestor()` serve para `list` porque nao depende do curinga: ela le
       * so o cadastro de QUEM PEDE. Um aluno continua sem listar — ele nao tem
       * nada a fazer com a lista da academia.
       */
      allow get: if souEu(uid) || mesmaAcademiaQue(uid);
      allow list: if souGestor();

      // Duas formas de nascer um cadastro, e nenhuma delas e aberta:
      //
      // 1. o professor cria direto (uid ja conhecido, ex. recadastro)
      // 2. a PROPRIA pessoa cria, e SO se houver convite para o e-mail dela
      //
      // No caminho 2, papel, academia, TURMA e META vem DO CONVITE e nao do que
      // o cliente mandou. Sem isso, quem tem convite de aluno se cadastraria
      // como professor e veria a turma toda.
      allow create: if (
          request.resource.data.academiaId == minhaAcademia()
          && (
            // Mesma divisao dos convites: o admin cria aluno; papel com poder so
            // o professor cria.
            (souGestor() && request.resource.data.papel == 'aluno')
            || (souProfessor() && request.resource.data.papel in ['aluno', 'professor', 'admin'])
          )
        ) || (
          souEu(uid)
          // E-mail nao verificado nao vale: com link magico ele sempre vem
          // verificado, e exigir isso fecha a porta para outros provedores que
          // possam ser ligados depois sem essa garantia.
          && request.auth.token.email_verified == true
          && temConviteValido()
        );

      /**
       * Fica em funcao para os dois get() ficarem juntos e contados.
       *
       * A TURMA E COMPARADA COM `get('turma', '')` DOS DOIS LADOS, e o default
       * nao e frouxidao: todo convite criado antes deste campo existir nao tem
       * a chave. Comparar `c.data.turma` direto faria a regra ERRAR nesses
       * convites — e erro em regra e negacao, entao um convite legitimo pendente
       * pararia de funcionar no deploy, silenciosamente, e a pessoa veria "sem
       * convite" com o convite na tela do professor.
       *
       * Com o default, convite antigo (sem turma) exige cadastro sem turma, que
       * e exatamente o que ele autoriza. O professor atribui a turma depois.
       */
      function temConviteValido() {
        let c = get(/databases/$(database)/documents/convites/$(request.auth.token.email));
        return c != null
          && request.resource.data.papel == c.data.papel
          && request.resource.data.academiaId == c.data.academiaId
          && request.resource.data.get('turma', '') == c.data.get('turma', '')
          /**
           * META, pelo mesmo `get(..., '')` e pelo mesmo motivo da turma: todo
           * convite criado antes deste campo nao tem a chave, e comparar
           * `c.data.meta` direto faria a regra ERRAR nesses convites — negando
           * um convite legitimo em silencio, com ele visivel na tela do
           * professor.
           *
           * E a meta decide contra QUE PROVA o aluno e medido, entao deixa-la
           * escolhida pelo cliente seria deixar o proprio aluno escolher o
           * exame dele.
           */
          && request.resource.data.get('meta', '') == c.data.get('meta', '')
          && request.resource.data.ativo == true;
      }

      /**
       * O aluno atualiza o proprio NOME e nada mais.
       *
       * LISTA DE PERMISSAO, E NAO DE PROIBICAO — e a mudanca importa mais que
       * parece. A versao anterior ENUMERAVA o que ele nao podia mudar:
       *
       *   request.resource.data.papel      == resource.data.papel
       *   request.resource.data.academiaId == resource.data.academiaId
       *   request.resource.data.ativo      == resource.data.ativo
       *
       * Funcionava porque a lista era completa. No instante em que `turma`
       * passou a existir ela deixou de ser, e o aluno se transferiria de turma
       * sozinho — sem erro, sem tela vermelha, e sem nenhum teste reclamar,
       * porque nenhum teste falava de um campo que ainda nao existia.
       *
       * `hasOnly(['nome'])` inverte o padrao: campo novo nasce PROTEGIDO, e
       * abrir um exige escrever aqui de propósito. ISSO JA SE PAGOU: quando
       * `meta` entrou (ADR-016), o aluno ficou impedido de trocar a propria
       * meta — que decide contra que prova ele e medido — sem uma linha de
       * regra nova. Com a enumeracao antiga, teria escapado igual a `turma`. E o mesmo defeito de forma
       * que a guarda de autenticacao tinha (ver `souAtivo`): a decisao precisa
       * estar escrita, nao ser consequencia de a lista estar em dia.
       */
      /**
       * TRES NIVEIS, E O CAMPO `papel` E A LINHA QUE FECHA A PORTA DOS FUNDOS.
       *
       * - o ALUNO muda o proprio nome, e nada mais
       * - o ADMIN muda tudo MENOS `papel` — de ninguem, inclusive o dele
       * - o PROFESSOR muda tudo
       *
       * SEM A EXCECAO DO `papel`, A DIVISAO ADMIN/PROFESSOR SERIA TEATRO
       * (ADR-017, decisao 2): bastaria o admin gravar `papel: 'professor'` no
       * proprio cadastro para passar a assinar competencia e graduacao. A regra
       * que impede o desenvolvedor de se graduar nao e a de `competencias` — e
       * esta linha.
       *
       * `hasOnly` NO CAMINHO DO ALUNO, LISTA NEGATIVA NO DO ADMIN, e a assimetria
       * e deliberada. Para o aluno, campo novo deve nascer PROTEGIDO: e o que fez
       * `meta` (ADR-016) e `estuda` (ADR-017) ficarem fora do alcance dele sem
       * nenhuma regra nova. Para o admin o padrao certo e o oposto — campo novo
       * deve nascer ADMINISTRAVEL, porque a razao de o papel existir e ele poder
       * administrar; o que precisa ser enumerado e a excecao, e a excecao e uma.
       *
       * O RISCO DA LISTA NEGATIVA e alguem acrescentar um segundo campo tao
       * perigoso quanto `papel` e esquecer de po-lo aqui. Fica escrito: se um
       * campo novo decidir PODER (e nao dado), ele entra nesta lista.
       */
      allow update: if (
          souEu(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        ) || (
          professorDaAcademiaDe(uid)
        ) || (
          mesmaAcademiaQue(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['papel'])
        );

      /**
       * APAGAR CONTINUA SENDO DOS DOIS, e eu quase restringi ao professor por
       * simetria com o `papel`. Seria errado: apagar cadastro e o que atende um
       * pedido de exclusao de dados, e esse pedido e trabalho ADMINISTRATIVO.
       * Um admin que nao consegue apagar nao consegue honrar a LGPD, e a
       * simetria bonita teria custado uma obrigacao legal.
       *
       * A linha do ADR-017 e sobre ASSINAR evidencia, e nao sobre destruir dado.
       */
      allow delete: if mesmaAcademiaQue(uid);
    }

    // ------------------------------------------------------------- estados
    // O blob do aluno. Escrita EXCLUSIVA dele.

    match /estados/{uid} {
      allow read: if (souEu(uid) && souAtivo()) || mesmaAcademiaQue(uid);

      // O professor NAO escreve aqui. E o que dispensa merge entre os dois.
      allow create, update: if souEu(uid) && souAtivo();

      // Nem o proprio aluno apaga: a saida e desativacao pela central, com
      // expurgo depois do prazo. Apagar por conta propria contornaria isso.
      allow delete: if mesmaAcademiaQue(uid);
    }

    // ------------------------------------------------------------- resumos
    // Derivado do estado, gravado pelo proprio aluno ao sincronizar. E o que a
    // central lista — sem ele, abrir a central custaria baixar 20 blobs.

    match /resumos/{uid} {
      allow read: if souEu(uid) || mesmaAcademiaQue(uid);
      allow create, update: if souEu(uid) && souAtivo();
      allow delete: if mesmaAcademiaQue(uid);
    }

    // -------------------------------------------------------------- grades
    // A grade das 10 aulas de cada aluno. Escrita EXCLUSIVA do professor.

    match /grades/{alunoUid}/aulas/{numero} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);
      allow write: if mesmaAcademiaQue(alunoUid);
    }

    // ---------------------------------------------------------- validacoes
    // Append-only: o professor registra, ninguem edita nem apaga. Historico de
    // validacao que pode ser reescrito nao serve como evidencia de graduacao.

    match /validacoes/{id} {
      allow read: if souEu(resource.data.alunoUid) || mesmaAcademiaQue(resource.data.alunoUid);
      // SO O PROFESSOR (ADR-017, decisao 1): dizer que o texto de uma tecnica
      // esta certo e autoridade de tatame. O admin escreveu o texto — deixa-lo
      // validar seria ele conferindo o proprio trabalho.
      allow create: if professorDaAcademiaDe(request.resource.data.alunoUid);
      allow update, delete: if false;
    }

    // -------------------------------------------------------- competencias
    /**
     * O professor atestando que ESTE ALUNO executa. Append-only.
     *
     * NAO E `validacoes`, e a diferenca esta no que cada uma afirma:
     * `validacoes` diz que o TEXTO da tecnica esta certo; aqui diz que a PESSOA
     * executa. A descricao pode estar perfeita e o aluno nao fazer.
     *
     * O uid NO CAMINHO e nao dentro do documento, e isso e exigencia das regras
     * e nao estetica: `validacoes/{id}` tem `alunoUid` no corpo, entao a regra
     * so e decidivel documento por documento e o Firestore recusa uma consulta
     * de colecao. A folha do atestado precisa LISTAR as competencias de um
     * aluno — com o uid no caminho, a mesma regra autoriza a lista.
     *
     * `update, delete: if false` — nem o professor edita. Evidencia de
     * graduacao reescrivel nao serve como evidencia (ADR-010). Retirar um
     * atestado e um registro NOVO com `competente: false`.
     */
    match /competencias/{alunoUid}/registros/{id} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);

      // O PROFESSOR da academia atesta — nem o aluno, nem o admin. Atestar a si
      // mesmo seria o aluno se graduando sozinho; e o admin tem cadastro de
      // aluno nesta mesma academia (ADR-017, decisao 5), entao `mesmaAcademiaQue`
      // aqui seria exatamente a porta pela qual o desenvolvedor assinaria a
      // propria competencia.
      allow create: if professorDaAcademiaDe(alunoUid)
        // Texto obrigatorio TAMBEM na regra, e nao so no cliente: o cliente e
        // codigo que vai para o navegador de qualquer pessoa. Atestacao sem
        // justificativa nao e rastreavel, e a fronteira e aqui.
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        // Quem atesta e quem esta autenticado. Sem isto, um professor poderia
        // gravar uma atestacao assinada por OUTRO professor.
        && request.resource.data.professorUid == request.auth.uid
        && request.resource.data.competente is bool;

      allow update, delete: if false;
    }

    // --------------------------------------------------------- graduacoes
    /**
     * O ato de conceder a graduacao. Append-only, pelos mesmos motivos.
     *
     * O APP NUNCA GRADUA: ele diz que os requisitos fecharam e o professor
     * decide. Por isso existe um registro do ATO, com quem concedeu e quando —
     * e com quantas aulas ele CONFIRMOU, que pode nao ser um numero que o
     * sistema contou.
     */
    match /graduacoes/{alunoUid}/registros/{id} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);

      // SO O PROFESSOR. Conceder graduacao e o ato mais irreversivel do
      // sistema, e o unico papel com autoridade para ele e o de quem esta no
      // tatame. Ver ADR-017, decisao 1.
      allow create: if professorDaAcademiaDe(alunoUid)
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.professorUid == request.auth.uid
        && request.resource.data.meta is string
        && request.resource.data.meta.size() > 0;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------- indicacoes
    // O video que o PROFESSOR indica. Fica separado do item do aluno para as
    // duas escolhas conviverem em vez de uma sobrescrever a outra.

    match /indicacoes/{alunoUid}/itens/{itemId} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);
      allow write: if mesmaAcademiaQue(alunoUid);
    }

    // ------------------------------------------------------------- o resto
    // Nada mais existe. Sem esta negacao final, uma colecao criada no futuro
    // nasceria sem regra — e no Firestore ausencia de regra e negacao, mas
    // deixar explicito impede que alguem "conserte" isso com um match aberto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
