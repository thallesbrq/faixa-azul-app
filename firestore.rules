rules_version = '2';

// ---------------------------------------------------------------------------
// Regras de acesso ao Firestore.
//
// ESTE ARQUIVO E A UNICA FRONTEIRA DE SEGURANCA DO PRODUTO.
//
// O bundle JavaScript vai para o navegador de qualquer pessoa, e a chave de API
// do Firebase vai dentro dele — repositorio privado nao muda isso. Portanto
// nada no cliente protege nada. Se uma regra aqui estiver errada, um aluno le o
// progresso de outro, e NADA QUEBRA: nao ha erro, nao ha tela vermelha, so
// alguem vendo o que nao devia. Por isso cada regra tem teste em
// firestore.rules.test.ts, e o CI barra o deploy se um deles falhar.
//
// PRINCIPIO: a posse e desenhada para que o conflito nao exista.
//   - o ALUNO escreve so o proprio estado
//   - o PROFESSOR escreve so grade, validacao e indicacao
//   - nenhum dos dois consegue escrever no campo do outro
// Assim a disputa aluno-professor deixa de ser problema de merge e passa a ser
// impossivel por construcao.
//
// SOBRE O LOG DO EMULADOR: ele reporta `evaluation error` em algumas negacoes,
// alem de `false`. Duas causas reais foram encontradas e corrigidas (ordem da
// guarda de autenticacao, e `.data` sem guarda de nulo). Restaram entradas que
// eu NAO consegui atribuir — nenhuma delas muda resultado: as 43 assercoes
// cobrem cada caminho de permitir e negar, e todas passam. Fica registrado como
// observacao aberta, e nao como coisa entendida.
//
// UMA HIPOTESE TESTADA E REFUTADA, para ninguem gastar a mesma hora de novo:
// achei que o erro na regra de `update` de `pessoas` viesse de `resource` ser
// nulo no caminho de create (um `set` faz o Firestore avaliar create E update).
// Acrescentei `resource != null` e rodei: o `evaluation error` continuou
// identico, na mesma linha e coluna. Nao e isso. O log tambem reporta erro E
// `false` para a MESMA linha na mesma requisicao, o que sugere mais de uma
// passagem de avaliacao — mas isso e suposicao, e fica como suposicao.
//
// CUSTO DE LEITURA: checar "quem sou eu" exige um get() em `pessoas`, e cada
// get() dentro de uma regra e uma leitura cobrada. Com 20 alunos e uma academia
// isso e irrisorio. A alternativa mais barata seria por o papel numa custom
// claim do token (zero leitura), mas isso exige Cloud Functions, que exige o
// plano Blaze. Fica registrado como a otimizacao a fazer se o custo aparecer.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------- ajudas

    function autenticado() {
      return request.auth != null;
    }

    function souEu(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    /**
     * DUAS CAMADAS DE PROPOSITO: a de fora guarda, a de dentro consulta.
     *
     * `let` em regra do Firestore e avaliado ANTES do `return` — nao ha
     * curto-circuito dentro da mesma funcao. Na primeira versao destas ajudas os
     * `let` ficavam junto do `return autenticado() && ...`, e com requisicao
     * anonima o caminho `pessoas/$(request.auth.uid)` era montado com uid nulo:
     * a regra ERRAVA em vez de NEGAR. O emulador negava do mesmo jeito (erro em
     * regra e negacao) e os 23 testes passavam — negando pelo motivo errado.
     *
     * Negacao por erro e fragil: ela nao expressa a decisao, so acontece. Uma
     * edicao futura que mude a ordem das clausulas pode transformar erro em
     * permissao sem nenhum teste reclamar.
     *
     * Com a guarda numa funcao de FORA, o `&&` curto-circuita antes de chamar a
     * de dentro, e nenhum `get()` e montado sem auth.
     *
     * Custo: o Firestore permite dez acessos a documento por avaliacao e cobra
     * cada um. As funcoes internas gastam no maximo dois.
     */
    function souAtivo() {
      return autenticado() && euAtivo();
    }

    function euAtivo() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null && eu.data.ativo == true;
    }

    function souProfessor() {
      return autenticado() && euProfessor();
    }

    function euProfessor() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null && eu.data.papel == 'professor' && eu.data.ativo == true;
    }

    // O professor so alcanca quem esta na MESMA academia. Hoje existe uma so,
    // entao a comparacao e sempre verdadeira — e esta escrita de proposito:
    // quando aparecer a segunda academia, o isolamento ja esta aqui, e nao
    // dependera de alguem lembrar de acrescentar.
    function mesmaAcademiaQue(uid) {
      return autenticado() && euProfessorDaAcademiaDe(uid);
    }

    function euProfessorDaAcademiaDe(uid) {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      let ele = get(/databases/$(database)/documents/pessoas/$(uid));
      return eu != null && ele != null
        && eu.data.papel == 'professor'
        && eu.data.ativo == true
        && eu.data.academiaId == ele.data.academiaId;
    }

    // Sem guarda de nulo, `.data` sobre um get() que nao achou nada faz a regra
    // ERRAR. Erro em regra e negacao, entao o efeito visivel e o mesmo — mas a
    // decisao deixa de estar escrita e passa a ser acidente.
    function minhaAcademia() {
      let eu = get(/databases/$(database)/documents/pessoas/$(request.auth.uid));
      return eu != null ? eu.data.academiaId : '';
    }

    // ------------------------------------------------------------- convites
    /**
     * Convite indexado por E-MAIL, e nao por uid.
     *
     * O FURO QUE ISTO FECHA: `pessoas/{uid}` so podia ser criado por um
     * professor, mas o uid nasce no PRIMEIRO LOGIN. Ou seja, o professor nao
     * tinha o que digitar — o convite era impossivel de existir. O e-mail, ao
     * contrario, ele sabe antes.
     *
     * Com isso a pessoa passa a poder criar o PROPRIO cadastro, mas SO quando
     * ha convite para o e-mail dela. Continua nao existindo cadastro aberto: sem
     * convite, ninguem entra.
     *
     * O id do documento e o e-mail em minusculas. E-mail e id valido no
     * Firestore (nao contem `/`), e normalizar evita que
     * `Thalles@x.com` e `thalles@x.com` sejam dois convites.
     */
    match /convites/{email} {
      // O convidado le o proprio convite (para saber que existe); o professor
      // le todos os da academia dele.
      allow read: if souProfessor()
        || (autenticado() && request.auth.token.email == email);

      allow create, update: if souProfessor()
        && request.resource.data.academiaId == minhaAcademia()
        && request.resource.data.papel in ['aluno', 'professor'];

      // CONVITE E DE USO UNICO: quem consome apaga o proprio. Sem isto, um
      // convite antigo ficaria valido para sempre — e se o professor
      // desativasse alguem apagando o cadastro, a pessoa se recadastraria com o
      // convite velho. O professor tambem pode apagar (cancelar convite).
      allow delete: if souProfessor()
        || (autenticado() && request.auth.token.email == email);
    }

    // ------------------------------------------------------------- pessoas

    match /pessoas/{uid} {
      // Cada um le o proprio cadastro; o professor le os da academia dele.
      allow read: if souEu(uid) || mesmaAcademiaQue(uid);

      // Duas formas de nascer um cadastro, e nenhuma delas e aberta:
      //
      // 1. o professor cria direto (uid ja conhecido, ex. recadastro)
      // 2. a PROPRIA pessoa cria, e SO se houver convite para o e-mail dela
      //
      // No caminho 2, papel, academia e TURMA vem DO CONVITE e nao do que o
      // cliente mandou. Sem isso, quem tem convite de aluno se cadastraria como
      // professor e veria a turma toda.
      allow create: if (
          souProfessor()
          && request.resource.data.academiaId == minhaAcademia()
          && request.resource.data.papel in ['aluno', 'professor']
        ) || (
          souEu(uid)
          // E-mail nao verificado nao vale: com link magico ele sempre vem
          // verificado, e exigir isso fecha a porta para outros provedores que
          // possam ser ligados depois sem essa garantia.
          && request.auth.token.email_verified == true
          && temConviteValido()
        );

      /**
       * Fica em funcao para os dois get() ficarem juntos e contados.
       *
       * A TURMA E COMPARADA COM `get('turma', '')` DOS DOIS LADOS, e o default
       * nao e frouxidao: todo convite criado antes deste campo existir nao tem
       * a chave. Comparar `c.data.turma` direto faria a regra ERRAR nesses
       * convites — e erro em regra e negacao, entao um convite legitimo pendente
       * pararia de funcionar no deploy, silenciosamente, e a pessoa veria "sem
       * convite" com o convite na tela do professor.
       *
       * Com o default, convite antigo (sem turma) exige cadastro sem turma, que
       * e exatamente o que ele autoriza. O professor atribui a turma depois.
       */
      function temConviteValido() {
        let c = get(/databases/$(database)/documents/convites/$(request.auth.token.email));
        return c != null
          && request.resource.data.papel == c.data.papel
          && request.resource.data.academiaId == c.data.academiaId
          && request.resource.data.get('turma', '') == c.data.get('turma', '')
          && request.resource.data.ativo == true;
      }

      /**
       * O aluno atualiza o proprio NOME e nada mais.
       *
       * LISTA DE PERMISSAO, E NAO DE PROIBICAO — e a mudanca importa mais que
       * parece. A versao anterior ENUMERAVA o que ele nao podia mudar:
       *
       *   request.resource.data.papel      == resource.data.papel
       *   request.resource.data.academiaId == resource.data.academiaId
       *   request.resource.data.ativo      == resource.data.ativo
       *
       * Funcionava porque a lista era completa. No instante em que `turma`
       * passou a existir ela deixou de ser, e o aluno se transferiria de turma
       * sozinho — sem erro, sem tela vermelha, e sem nenhum teste reclamar,
       * porque nenhum teste falava de um campo que ainda nao existia.
       *
       * `hasOnly(['nome'])` inverte o padrao: campo novo nasce PROTEGIDO, e
       * abrir um exige escrever aqui de propósito. E o mesmo defeito de forma
       * que a guarda de autenticacao tinha (ver `souAtivo`): a decisao precisa
       * estar escrita, nao ser consequencia de a lista estar em dia.
       */
      allow update: if (
          souEu(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        ) || mesmaAcademiaQue(uid);

      // Apagar e do professor (a saida do aluno passa pela central).
      allow delete: if mesmaAcademiaQue(uid);
    }

    // ------------------------------------------------------------- estados
    // O blob do aluno. Escrita EXCLUSIVA dele.

    match /estados/{uid} {
      allow read: if (souEu(uid) && souAtivo()) || mesmaAcademiaQue(uid);

      // O professor NAO escreve aqui. E o que dispensa merge entre os dois.
      allow create, update: if souEu(uid) && souAtivo();

      // Nem o proprio aluno apaga: a saida e desativacao pela central, com
      // expurgo depois do prazo. Apagar por conta propria contornaria isso.
      allow delete: if mesmaAcademiaQue(uid);
    }

    // ------------------------------------------------------------- resumos
    // Derivado do estado, gravado pelo proprio aluno ao sincronizar. E o que a
    // central lista — sem ele, abrir a central custaria baixar 20 blobs.

    match /resumos/{uid} {
      allow read: if souEu(uid) || mesmaAcademiaQue(uid);
      allow create, update: if souEu(uid) && souAtivo();
      allow delete: if mesmaAcademiaQue(uid);
    }

    // -------------------------------------------------------------- grades
    // A grade das 10 aulas de cada aluno. Escrita EXCLUSIVA do professor.

    match /grades/{alunoUid}/aulas/{numero} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);
      allow write: if mesmaAcademiaQue(alunoUid);
    }

    // ---------------------------------------------------------- validacoes
    // Append-only: o professor registra, ninguem edita nem apaga. Historico de
    // validacao que pode ser reescrito nao serve como evidencia de graduacao.

    match /validacoes/{id} {
      allow read: if souEu(resource.data.alunoUid) || mesmaAcademiaQue(resource.data.alunoUid);
      allow create: if mesmaAcademiaQue(request.resource.data.alunoUid);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- indicacoes
    // O video que o PROFESSOR indica. Fica separado do item do aluno para as
    // duas escolhas conviverem em vez de uma sobrescrever a outra.

    match /indicacoes/{alunoUid}/itens/{itemId} {
      allow read: if souEu(alunoUid) || mesmaAcademiaQue(alunoUid);
      allow write: if mesmaAcademiaQue(alunoUid);
    }

    // ------------------------------------------------------------- o resto
    // Nada mais existe. Sem esta negacao final, uma colecao criada no futuro
    // nasceria sem regra — e no Firestore ausencia de regra e negacao, mas
    // deixar explicito impede que alguem "conserte" isso com um match aberto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
